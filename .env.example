# Docker Compose only. Copy to .env at the repository root, then fill both JWT secrets.
# Generate EACH value separately (no default secrets):
# docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public browser origins: no paths/trailing slashes or Docker service names.
# Change all matching ports/URLs together.
APP_BIND=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=3000
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3000

# Optional for startup. Supply real provider credentials to use uploads/payment.
# These are backend runtime values only; never prefix secrets with VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
