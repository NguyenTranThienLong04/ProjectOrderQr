PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>?appName=<appName>
# Optional local-only workaround for networks that block Node DNS SRV lookups to MongoDB Atlas.
# Leave unset in other environments so Node keeps the system DNS resolver.
# CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Active Sessions with zero Orders expire after this much meaningful inactivity.
EMPTY_SESSION_TIMEOUT_MINUTES=10
JWT_ACCESS_SECRET=<generate_a_long_random_secret>
JWT_REFRESH_SECRET=<generate_a_different_long_random_secret>
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
VNP_TMN_CODE=<your_vnpay_terminal_code>
VNP_HASH_SECRET=<your_vnpay_hash_secret>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Backend has no /api prefix; it runs on port 3000 by default.
VNP_RETURN_URL=http://localhost:3000/vnpay/return
# Set this to a public HTTPS tunnel URL for real IPN testing, e.g. https://xxxx.ngrok-free.app/vnpay/ipn
VNP_IPN_URL=
# Temporarily set true while investigating a signature mismatch. Logs signData and masks secrets.
VNPAY_DEBUG=false
