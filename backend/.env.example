PORT=3000
NODE_ENV=development
# Render provides PORT; use NODE_ENV=production and TRUST_PROXY=1 there.
# Trust one reverse proxy hop on Render; leave unset for direct local access.
TRUST_PROXY=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>?appName=<appName>
# Optional local-only workaround for networks that block Node DNS SRV lookups to MongoDB Atlas.
# Leave unset in other environments so Node keeps the system DNS resolver.
# CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Render: FRONTEND_URL=https://<frontend-site>.onrender.com (required in production).
# CORS_ORIGIN defaults to FRONTEND_URL; optionally use comma-separated origins.
# Trailing slashes are normalized. Do not use *.
# Active Sessions with zero Orders expire after this much meaningful inactivity.
EMPTY_SESSION_TIMEOUT_MINUTES=10
JWT_ACCESS_SECRET=<generate_a_long_random_secret>
JWT_REFRESH_SECRET=<generate_a_different_long_random_secret>
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
VNP_TMN_CODE=<your_vnpay_terminal_code>
VNP_HASH_SECRET=<your_vnpay_hash_secret>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Backend has no /api prefix; it runs on port 3000 by default.
VNP_RETURN_URL=http://localhost:3000/vnpay/return
# Render: VNP_RETURN_URL=https://<backend-service>.onrender.com/vnpay/return
# Register https://<backend-service>.onrender.com/vnpay/ipn with VNPAY.
# VNP_IPN_URL is an operator reference only: the application does not read it
# or register it with VNPAY. Setting it alone does not enable IPN delivery.
VNP_IPN_URL=
# Temporarily set true while investigating a signature mismatch. Logs signData and masks secrets.
VNPAY_DEBUG=false

# Phase 16: explicit CLI only; never loaded by backend startup to seed data.
# Set these deliberately for a separate development/demo database. No fallback
# from AI_DEMO_MONGODB_URI to the application's MONGODB_URI.
# AI_DEMO_MONGODB_URI=mongodb://localhost:27017/smartorder_ai_demo?replicaSet=rs0
# AI_DEMO_DB_NAME=smartorder_ai_demo
# AI_DEMO_ALLOW_WRITE=I_UNDERSTAND_SYNTHETIC_DATA
# Reset only: stop all apps connected to that demo DB before acknowledging.
# AI_DEMO_APP_STOPPED=yes
# Integration tests only: dedicated dev/test Mongo host (unique DB override).
# AI_DEMO_TEST_MONGODB_URI=mongodb://localhost:27017/smartorder_ai_demo?replicaSet=rs0

# Phase 17: optional backend-only AI; no provider call during startup.
AI_ENABLED=false
# Render selected configuration: AI_ENABLED=true, AI_PROVIDER=groq.
# Supported providers: openai | gemini | groq
AI_PROVIDER=openai
# OpenAI only: existing env names remain supported.
AI_API_KEY=
# Explicit structured-output capable model ID; prefer a pinned snapshot.
AI_MODEL=
# Gemini only: set AI_ENABLED=true and AI_PROVIDER=gemini to select it.
# Backend secret only; never use a VITE_ prefix or put a real key in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Groq only: selected Render production provider (also available for dev/testing).
# Backend secret only; leave this example key empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Per attempt: integer 100..60000 ms. Retries: integer 0..2, after initial call.
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=1
