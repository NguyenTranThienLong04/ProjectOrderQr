# Public backend origin, without /api (this project has no API prefix).
# Local development:
VITE_API_URL=http://localhost:3000
# Render Static Site: replace with https://<backend-service>.onrender.com
# Set before building; changing this value requires a new frontend build.
# Never put MongoDB/JWT/Cloudinary/Groq/VNPAY secrets in VITE_* variables.
